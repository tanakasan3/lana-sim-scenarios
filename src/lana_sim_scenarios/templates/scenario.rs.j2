use std::time::Duration;

use es_entity::clock::{ClockController, ClockHandle};
{% if scenario.has_clock_reset %}
use es_entity::prelude::chrono::{self, TimeZone, Utc};
{% else %}
use es_entity::prelude::chrono;
{% endif %}
use futures::StreamExt;
use lana_app::{
    app::LanaApp, 
    primitives::*,
    terms::{DisbursalPolicy, FacilityDuration, InterestInterval, ObligationDuration, TermValues},
};
use lana_events::{CoreCreditCollectionEvent, CoreCreditEvent, LanaEvent{% if scenario.has_obligation_type_filtering %}, ObligationType{% endif %}};
use rust_decimal_macros::dec;
use tracing::{event, instrument};

use crate::helpers;

const ONE_DAY: Duration = Duration::from_secs(86400);
const EVENT_WAIT_TIMEOUT: Duration = Duration::from_millis(100);
{% if scenario.has_monthly_delay %}
const ONE_MONTH_DAYS: i64 = 30;
{% endif %}

#[instrument(
    name = "sim_bootstrap.{{ scenario.fn_name }}_scenario",
    skip(app, clock, clock_ctrl),
    err
)]
pub async fn {{ scenario.fn_name }}_scenario(
    sub: Subject,
    app: &LanaApp,
    clock: &ClockHandle,
    clock_ctrl: &ClockController,
) -> anyhow::Result<()> {
    event!(tracing::Level::INFO, "Starting {{ scenario.name }} scenario");

{% if scenario.start_date %}
    // Reset clock to explicit date: {{ scenario.start_date }}
    {% set parts = scenario.start_date_parts %}
    let target_time = Utc.with_ymd_and_hms({{ parts[0] }}, {{ parts[1] }}, {{ parts[2] }}, 12, 0, 0).unwrap();
    clock_ctrl.reset_to(target_time);

{% elif scenario.start_offset_days %}
    // Reset clock to {{ scenario.start_offset_days }} days from now
    let target_time = Utc::now() - chrono::Duration::days({{ scenario.start_offset_days|abs }});
    clock_ctrl.reset_to(target_time);

{% endif %}
    let mut stream = app.outbox().listen_persisted(None);

    // Create customer and make deposit
    let (customer_id, _) = helpers::create_customer(&sub, app, "{{ scenario.customer_suffix }}").await?;
    let deposit_amount = UsdCents::try_from_usd(dec!({{ scenario.deposit_amount_usd }}))?;
    helpers::make_deposit(&sub, app, &customer_id, deposit_amount).await?;

    // Create facility with terms
    let cf_terms = {{ scenario.terms_builder }};
    let cf_amount = UsdCents::try_from_usd(dec!({{ scenario.facility_amount_usd }}))?;
    let cf_proposal = app
        .create_facility_proposal(&sub, customer_id, cf_amount, cf_terms, None::<CustodianId>)
        .await?;
    let proposal_id = cf_proposal.id;
    let cf_id: CreditFacilityId = proposal_id.into();

    // Customer approves
    app.credit()
        .proposals()
        .conclude_customer_approval(&sub, proposal_id, true)
        .await?;

    // Wait for proposal approval (committee)
{% if scenario.has_approval_timeout %}
    let mut days_waiting_for_approval = 0;
{% endif %}
    loop {
        tokio::select! {
            Some(msg) = stream.next() => {
                if let Some(LanaEvent::Credit(CoreCreditEvent::FacilityProposalConcluded {
                    entity,
                })) = &msg.payload
                    && entity.status == CreditFacilityProposalStatus::Approved
                    && entity.id == proposal_id
                {
                    msg.inject_trace_parent();
                    break;
                }
                if let Some(LanaEvent::Credit(CoreCreditEvent::FacilityProposalConcluded {
                    entity,
                })) = &msg.payload
                    && entity.status == CreditFacilityProposalStatus::Denied
                    && entity.id == proposal_id
                {
                    anyhow::bail!("Proposal was denied");
                }
            }
            _ = tokio::time::sleep(EVENT_WAIT_TIMEOUT) => {
                clock_ctrl.advance(ONE_DAY).await;
{% if scenario.has_approval_timeout %}
                days_waiting_for_approval += 1;
                if days_waiting_for_approval > {{ scenario.approval_timeout_days|default(30) }} {
                    anyhow::bail!("Proposal approval timed out");
                }
{% endif %}
            }
        }
    }

    // Update collateral to activate facility
    let pending_facility = app
        .credit()
        .pending_credit_facilities()
        .find_by_id(&sub, proposal_id)
        .await?
        .expect("pending facility exists");

    app.credit()
        .collaterals()
        .update_collateral_by_id(
            &sub,
            pending_facility.collateral_id,
            Satoshis::try_from_btc(dec!({{ scenario.collateral_btc }}))?,
            clock.today(),
        )
        .await?;

    // Wait for facility activation
{% if scenario.has_activation_timeout %}
    let mut days_waiting_for_activation = 0;
{% endif %}
{% if scenario.tracks_activation_date %}
    let activation_date;
{% endif %}
    loop {
        tokio::select! {
            Some(msg) = stream.next() => {
                if let Some(LanaEvent::Credit(CoreCreditEvent::FacilityActivated { entity })) = &msg.payload
                    && entity.id == cf_id
                {
                    msg.inject_trace_parent();
{% if scenario.tracks_activation_date %}
                    activation_date = clock.today();
{% endif %}
{{ scenario.on_activation_code|indent(20, true) }}
                    break;
                }
            }
            _ = tokio::time::sleep(EVENT_WAIT_TIMEOUT) => {
                clock_ctrl.advance(ONE_DAY).await;
{% if scenario.has_activation_timeout %}
                days_waiting_for_activation += 1;
                if days_waiting_for_activation > {{ scenario.activation_timeout_days|default(30) }} {
                    anyhow::bail!("Facility activation timed out");
                }
{% endif %}
            }
        }
    }

{{ scenario.main_loop_code }}

    event!(tracing::Level::INFO, facility_id = %cf_id, "{{ scenario.name }} scenario completed");
    Ok(())
}
